#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
# Write the third-party licenses of the crates that each binary links:
#
#   tools/licenses-binary DIR [BINARY...]
#
# DIR/THIRD-PARTY-LICENSES.BINARY gets, for each BINARY (default: velarx
# velarx-client velarx-monitor velarx-api velarx-p2p velarx-cri), the table
# of the crates of `cargo tree -e normal` of its package (name, version,
# license) and then the notice and license files that each crate ships
# (LICENSE*, COPYING*, NOTICE*, ...), the identical texts once.  The crates
# of the workspace are the project's own (LICENSE, NOTICE) and are not
# listed; the vendored crates under vendor/ are.
# CARGO is the cargo command, CARGOFLAGS its extra flags
# (--locked --offline in a packaging build).  A crate that declares MIT and ships
# no license file gets the standard MIT text with its authors; any other
# crate without a file (unless 0BSD, CC0-1.0, Unlicense) is an error.
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(root)
cargo = shlex.split(os.environ.get("CARGO", "cargo"))
flags = shlex.split(os.environ.get("CARGOFLAGS", ""))
# always the versions of Cargo.lock (cargo refuses a repeated --locked)
if "--locked" not in flags:
    flags.append("--locked")

PACKAGES = {
    "velarx": ["-p", "velarx-bin"],
    "velarx-monitor": ["-p", "velarx-monitor-bin"],
    "velarx-registry": ["-p", "velarx-registry-bin"],
    "velarx-dir": ["-p", "velarx-dir"],
    "velarx-kube": ["-p", "velarx-kube-bin"],
    "velarx-client": ["-p", "velarx-bin", "--no-default-features"],
    "velarx-api": ["-p", "velarx-api-bin"],
    "velarx-p2p": ["-p", "velarx-p2p-bin"],
    "velarx-cri": ["-p", "velarx-cri-bin"],
}
FILE = re.compile(
    r"^(LICEN[CS]E|COPYING|NOTICE|UNLICENSE|COPYRIGHT|PATENTS)([-_.].*)?$", re.I
)
NO_FILE_OK = {"0BSD", "CC0-1.0", "Unlicense"}
# The standard MIT text, for a crate that declares MIT but ships no license
# file (its authors from Cargo.toml stand for the copyright line).
MIT = """MIT License (the package ships no license file; this is the standard text
with the authors of its Cargo.toml)

Copyright (c) {authors}

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all
copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE."""


def run(args):
    return subprocess.run(
        cargo + args, check=True, stdout=subprocess.PIPE, text=True
    ).stdout


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: tools/licenses-binary DIR [BINARY...]")
    out = sys.argv[1]
    names = sys.argv[2:] or list(PACKAGES)
    for n in names:
        if n not in PACKAGES:
            sys.exit(f"tools/licenses-binary: unknown binary {n}")
    meta = json.loads(run(["metadata", "--format-version", "1"] + flags))
    by_id = {p["id"]: p for p in meta["packages"]}
    by_key = {(p["name"], p["version"]): p for p in meta["packages"]}
    ws = os.path.realpath(root)
    os.makedirs(out, exist_ok=True)
    problems = []
    for name in names:
        tree = run(
            ["tree", "-e", "normal", "--prefix", "none", "--format", "{p}"]
            + flags
            + PACKAGES[name]
        )
        crates = set()
        for line in tree.splitlines():
            m = re.match(r"(\S+) v(\S+)(?: \((.*?)\))?", line)
            if not m:
                continue
            crates.add((m.group(1), m.group(2)))
        entries = []
        for key in sorted(crates):
            p = by_key.get(key)
            if p is None:
                problems.append(f"{name}: {key} is not in cargo metadata")
                continue
            d = os.path.dirname(p["manifest_path"])
            rel = os.path.relpath(os.path.realpath(d), ws)
            if p["source"] is None and not rel.startswith("vendor/"):
                continue  # a package of the workspace
            texts = []
            for f in sorted(os.listdir(d)):
                if FILE.match(f) and os.path.isfile(os.path.join(d, f)):
                    with open(os.path.join(d, f), "rb") as fh:
                        texts.append((f, fh.read().decode("utf-8", "replace").strip()))
            lic = p["license"] or ("see " + p["license_file"] if p["license_file"] else "")
            if not lic:
                problems.append(f"{name}: {key[0]} {key[1]} has no license field")
            if not texts and "MIT" in re.split(r"[ ()/]+", lic):
                authors = ", ".join(a.split("<")[0].strip() for a in p["authors"]) or p["name"]
                texts.append(("generated", MIT.format(authors=authors)))
            if not texts and not set(re.split(r"[ ()/]+|AND|OR|WITH", lic)) <= NO_FILE_OK | {""}:
                problems.append(f"{name}: {key[0]} {key[1]} ({lic}) ships no license file")
            entries.append((key, lic, texts))
        groups = {}
        for key, lic, texts in entries:
            for f, t in texts:
                groups.setdefault(hashlib.sha256(t.encode()).hexdigest(), (t, []))[1].append(
                    f"{key[0]} {key[1]} ({f})"
                )
        path = os.path.join(out, f"THIRD-PARTY-LICENSES.{name}")
        with open(path, "w") as o:
            o.write(
                f"Third-party licenses of the crates linked into {name}\n"
                f"({len(entries)} crates; the output of tools/licenses-binary).\n"
                "The program itself is under Apache-2.0 (LICENSE, NOTICE).  The\n"
                "system libraries that it loads at run time (libc, OpenSSL, ...)\n"
                "are not part of this file.\n\n"
                "Crates\n======\n\n"
            )
            for key, lic, _ in entries:
                o.write(f"{key[0]} {key[1]}: {lic}\n")
            o.write("\nLicense and notice texts\n========================\n")
            for t, who in groups.values():
                o.write("\n" + "-" * 78 + "\n")
                o.write("\n".join(who) + "\n" + "-" * 78 + "\n\n" + t + "\n")
        print(f"{path}: {len(entries)} crates")
    if problems:
        sys.exit("\n".join(problems))


main()
