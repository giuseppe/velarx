def load_results(outdir):
    """{benchmark: {engine: stats}} from OUT/json/NAME.ENGINE.json; stats
    has mean, stddev, median, min, max and runs in seconds (stddev 0 for a
    single run)."""
    res = {}
    jdir = os.path.join(outdir, "json")
    for fn in sorted(os.listdir(jdir)) if os.path.isdir(jdir) else []:
        m = re.match(r"^(.+)\.(%s)\.json$" % "|".join(ENGINES), fn)
        if not m:
            continue
        with open(os.path.join(jdir, fn)) as f:
            r = json.load(f)["results"][0]
        res.setdefault(m.group(1), {})[m.group(2)] = dict(
            mean=r["mean"], stddev=r.get("stddev") or 0.0, median=r["median"],
            min=r["min"], max=r["max"], runs=len(r["times"]))
    return res


def ratio(res, bench):
    """velarx mean / podman mean of bench, None when either is missing."""
    b = res.get(bench, {})
    if "velarx" not in b or "podman" not in b or b["podman"]["mean"] <= 0:
        return None
    return b["velarx"]["mean"] / b["podman"]["mean"]


def fmt_time(s):
    if s >= 1:
        return "%.3f s" % s
    return "%.1f ms" % (s * 1000)


def table(res, order=None):
    """The markdown table: mean +- sigma per engine and velarx/podman."""
    names = [b["name"] for b in BENCHMARKS] if order is None else order
    names = [n for n in names if n in res] + sorted(n for n in res if n not in names)
    out = ["| operation | velarx | podman | velarx/podman |", "|---|---|---|---|"]
    for n in names:
        cells = []
        for e in ENGINES:
            s = res[n].get(e)
            cells.append("n/a" if s is None else "%s ± %s (n=%d)" % (
                fmt_time(s["mean"]), fmt_time(s["stddev"]), s["runs"]))
        r = ratio(res, n)
        if r is None:
            rs = "n/a"
        else:
            rs = "%.2f" % r
            if r > 1.05:
                rs += " (slower)"
            elif r < 0.95:
                rs += " (faster)"
        out.append("| %s | %s | %s | %s |" % (n, cells[0], cells[1], rs))
    return "\n".join(out) + "\n"


def slower(res, threshold=1.05):
    """The benchmarks in which velarx is slower than podman, worst first."""
    rows = [(ratio(res, n), n) for n in res if ratio(res, n) is not None]
    return [n for r, n in sorted(rows, reverse=True) if r > threshold]


COLORS = {"velarx": "#2a6fdb", "podman": "#d9822b"}


def svg_bars(title, rows, series, log, xlabel, refline=None):
    """A horizontal bar chart as SVG text.  rows: [(label, [value or None
    per series])], series: [(name, color)].  With log the axis is
    logarithmic; refline draws a vertical line at that value."""
    vals = [v for _, vs in rows for v in vs if v and v > 0]
    if not vals:
        return ""
    lo, hi = min(vals), max(vals)
    if refline:
        lo, hi = min(lo, refline), max(hi, refline)
    if log:
        lo = 10 ** math.floor(math.log10(lo) - 0.05)
        hi = 10 ** math.ceil(math.log10(hi) + 0.05)

        def pos(v):
            return (math.log10(v) - math.log10(lo)) / (math.log10(hi) - math.log10(lo))
    else:
        lo, hi = 0.0, hi * 1.08

        def pos(v):
            return (v - lo) / (hi - lo)
    left, right, top, rowh, bar = 150, 80, 50, 18 * len(series) + 12, 16
    width, plot = 900, 900 - 150 - 80
    height = top + rowh * len(rows) + 50
    o = ['<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" '
         'font-family="sans-serif" font-size="12">' % (width, height),
         '<rect width="100%" height="100%" fill="white"/>',
         '<text x="%d" y="24" font-size="15" font-weight="bold">%s</text>' % (left, title)]
    for i, (name, color) in enumerate(series):
        x = left + 160 * i
        o.append('<rect x="%d" y="32" width="12" height="12" fill="%s"/>'
                 '<text x="%d" y="43">%s</text>' % (x, color, x + 18, name))
    ticks = []
    if log:
        e = int(math.log10(lo))
        while 10 ** e <= hi * 1.001:
            ticks.append(10 ** e)
            e += 1
    else:
        step = 10 ** math.floor(math.log10(hi / 4))
        for m in (1, 2, 2.5, 5, 10):
            if hi / (step * m) <= 6:
                step *= m
                break
        t = 0.0
        while t <= hi:
            ticks.append(t)
            t += step
    bottom = top + rowh * len(rows)
    for t in ticks:
        x = left + plot * pos(t) if (t > 0 or not log) else left
        o.append('<line x1="%.1f" y1="%d" x2="%.1f" y2="%d" stroke="#ddd"/>'
                 '<text x="%.1f" y="%d" text-anchor="middle" fill="rgb(85,85,85)">%s</text>'
                 % (x, top, x, bottom, x, bottom + 16, ("%g" % t)))
    o.append('<text x="%d" y="%d" text-anchor="middle" fill="rgb(85,85,85)">%s</text>'
             % (left + plot / 2, bottom + 36, xlabel))
    for i, (label, vs) in enumerate(rows):
        y = top + rowh * i
        o.append('<text x="%d" y="%d" text-anchor="end">%s</text>'
                 % (left - 8, y + rowh / 2 + 4, label))
        for j, v in enumerate(vs):
            if not v or v <= 0:
                continue
            w = max(plot * pos(v), 1.0)
            by = y + 4 + 18 * j
            o.append('<rect x="%d" y="%d" width="%.1f" height="%d" fill="%s"/>'
                     '<text x="%.1f" y="%d" fill="rgb(51,51,51)">%s</text>'
                     % (left, by, w, bar, series[j][1], left + w + 4, by + 12,
                        ("%.2f" % v) if refline else fmt_time(v)))
    if refline:
        x = left + plot * pos(refline)
        o.append('<line x1="%.1f" y1="%d" x2="%.1f" y2="%d" stroke="rgb(34,34,34)" '
                 'stroke-dasharray="4 3"/>' % (x, top - 4, x, bottom))
    o.append("</svg>")
    return "\n".join(o) + "\n"


def write_graphs(res, outdir):
    """OUT/times.svg, OUT/ratio.svg and, with matplotlib, the .png too;
    returns the paths written."""
    names = [b["name"] for b in BENCHMARKS if b["name"] in res]
    names += sorted(n for n in res if n not in names)
    paths = []
    t_rows = [(n, [res[n].get(e, {}).get("mean") for e in ENGINES]) for n in names]
    r_rows = [(n, [ratio(res, n)]) for n in names if ratio(res, n)]
    series = [(e, COLORS[e]) for e in ENGINES]
    charts = [("times", "Mean time per operation (log scale, lower is better)",
               t_rows, series, True, "seconds", None),
              ("ratio", "velarx / podman mean time (under 1 = velarx is faster)",
               r_rows, [("velarx/podman", COLORS["velarx"])], False, "ratio", 1.0)]
    for fname, title, rows, ser, log, xlabel, ref in charts:
        text = svg_bars(title, rows, ser, log, xlabel, ref)
        if text:
            p = os.path.join(outdir, fname + ".svg")
            with open(p, "w") as f:
                f.write(text)
            paths.append(p)
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
    except ImportError:
        return paths
    for fname, title, rows, ser, log, xlabel, ref in charts:
        if not rows:
            continue
        fig, ax = plt.subplots(figsize=(9, 0.55 * len(rows) * len(ser) + 1.8))
        h = 0.8 / len(ser)
        for j, (sname, color) in enumerate(ser):
            ys = [i + (j - (len(ser) - 1) / 2) * h for i in range(len(rows))]
            vals = [vs[j] or 0 for _, vs in rows]
            ax.barh(ys, vals, height=h, color=color, label=sname)
            for y, v in zip(ys, vals):
                if v:
                    ax.text(v, y, " " + (("%.2f" % v) if ref else fmt_time(v)),
                            va="center", fontsize=7)
        ax.set_yticks(range(len(rows)))
        ax.set_yticklabels([n for n, _ in rows])
        ax.invert_yaxis()
        if log:
            ax.set_xscale("log")
        if ref:
            ax.axvline(ref, color="0.13", linestyle="--", linewidth=1)
        ax.set_xlabel(xlabel)
        ax.set_title(title, fontsize=10)
        ax.legend(loc="lower right", fontsize=8)
        ax.grid(axis="x", alpha=0.3)
        fig.tight_layout()
        p = os.path.join(outdir, fname + ".png")
        fig.savefig(p, dpi=110)
        plt.close(fig)
        paths.append(p)
    return paths


def loadavg():
    with open("/proc/loadavg") as f:
        return float(f.read().split()[0])


def say(msg):
    print(msg, file=sys.stderr, flush=True)


def sh(cmd, env, check=True, quiet=True):
    p = subprocess.run(cmd, shell=True, env=env, stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL if quiet else None,
                       stderr=subprocess.PIPE)
    if check and p.returncode != 0:
        raise RuntimeError("%s: %s" % (cmd, p.stderr.decode(errors="replace")[-1500:]))
    return p


def out_of(argv, env=None):
    p = subprocess.run(argv, env=env, capture_output=True, text=True)
    return (p.stdout + p.stderr).strip() if p.returncode == 0 else "unavailable"


# The variables that name other configuration files or another engine: the
# engines run without them.
OTHER_CONFIG_VARS = ("CONTAINERS_CONF", "CONTAINERS_STORAGE_CONF", "CONTAINERS_REGISTRIES_CONF",
                     "CONTAINERS_POLICY_JSON", "REGISTRY_AUTH_FILE", "CONTAINER_HOST",
                     "CONTAINER_CONNECTION", "VELARX_HOST", "VELARX_SOCKET", "DOCKER_HOST",
                     "DOCKER_CONFIG")


def private_env(home, rundir, tmpdir):
    """The environment of a program of the containers tools (podman,
    skopeo, velarx) that reads and writes nothing of the user's: HOME and
    every XDG_* directory under home, and none of the variables that name
    other configuration files or another engine."""
    for p in (home, rundir, tmpdir):
        os.makedirs(p, mode=0o700, exist_ok=True)
    env = dict(os.environ, HOME=home, XDG_CONFIG_HOME=home + "/.config",
               XDG_DATA_HOME=home + "/.local/share", XDG_CACHE_HOME=home + "/.cache",
               XDG_STATE_HOME=home + "/.local/state", XDG_RUNTIME_DIR=rundir, TMPDIR=tmpdir)
    for k in OTHER_CONFIG_VARS:
        env.pop(k, None)
    return env


class Engine:
    """One engine with a store, a home and the options that make it private."""

    def __init__(self, name, binary, work, runtime, runbase=None):
        """`runbase`: a directory on a tmpfs for what is of one boot, the
        run root, the runtime directory and the engine's temporary files,
        as the default of both engines has it (`$XDG_RUNTIME_DIR`)."""
        self.name, self.binary = name, binary
        self.dir = os.path.join(work, name[0])
        self.home = os.path.join(self.dir, "home")
        d = lambda *p: os.path.join(self.dir, *p)
        self.root, self.tmpdir = d("root"), d("tmp")
        r = (lambda *p: os.path.join(runbase, name[0], *p)) if runbase else d
        self.runroot, self.rundir = r("rr"), r("run")
        self.enginetmp = r("etmp") if runbase else self.tmpdir
        self.runbase = runbase and os.path.join(runbase, name[0])
        for p in (self.root, self.runroot, self.tmpdir, self.enginetmp, self.home + "/.config/containers",
                  self.home + "/.config/velarx", self.home + "/.local/share", self.rundir):
            os.makedirs(p, mode=0o700, exist_ok=True)
        self.env = private_env(self.home, self.rundir, self.tmpdir)
        opts = ["--root", self.root, "--runroot", self.runroot, "--tmpdir", self.enginetmp,
                "--runtime", runtime, "--cgroup-manager", "cgroupfs", "--events-backend", "file"]
        if name == "podman":
            opts += ["--storage-driver", "overlay"]
        self.argv = [binary] + opts

    @property
    def prefix(self):
        return shlex.join(self.argv)

    def registries(self, registry):
        conf = '[[registry]]\nlocation = "%s"\ninsecure = true\n' % registry
        for sub in ("containers", "velarx"):
            with open(os.path.join(self.home, ".config", sub, "registries.conf"), "w") as f:
                f.write(conf)

    def verify_private(self):
        """Abort unless the engine reports the directories asked for."""
        if self.name != "podman":
            return
        p = subprocess.run(self.argv + ["info", "--format",
                           "{{.Store.GraphRoot}}\n{{.Store.RunRoot}}\n{{.Store.GraphDriverName}}"],
                           env=self.env, capture_output=True, text=True)
        if p.returncode != 0:
            raise SystemExit("podman info failed: " + p.stderr[-500:])
        graph, run, driver = (p.stdout.split("\n") + ["", "", ""])[:3]
        for key, got, want in (("graphRoot", graph, self.root), ("runRoot", run, self.runroot)):
            if os.path.realpath(got or "/nonexistent") != os.path.realpath(want):
                raise SystemExit("podman reports %s %r, not the private %r: abort" % (key, got, want))
        if driver != "overlay":
            raise SystemExit("podman uses the %r storage driver, not overlay: abort" % driver)

    def stop(self):
        """Delete the store (the files of sub ids go through the engine's
        own unshare) and then stop podman's pause process, which that
        unshare starts again when it is not running."""
        subprocess.run(self.argv + ["unshare", "rm", "-rf", self.root, self.runroot, self.tmpdir,
                                    self.enginetmp, self.home], env=self.env, capture_output=True)
        for pf in self._find("pause.pid"):
            try:
                with open(pf) as f:
                    pid = int(f.read().strip())
                fd = os.pidfd_open(pid)
            except (OSError, ValueError):
                continue
            try:
                with open("/proc/%d/comm" % pid) as f:
                    comm = f.read().strip()
                # (catatonit -P when it is installed, else podman itself)
                if comm not in ("catatonit", "podman"):
                    continue
                for sig in (signal.SIGTERM, signal.SIGKILL):
                    signal.pidfd_send_signal(fd, sig)
                    if select.select([fd], [], [], 5)[0]:
                        break
                else:
                    say("warning: the pause process %d of %s did not exit" % (pid, self.name))
            except OSError:
                pass
            finally:
                os.close(fd)

    def _find(self, name):
        for base in (self.dir, self.runbase):
            for top, _, files in os.walk(base or self.dir):
                if name in files:
                    yield os.path.join(top, name)


class Registry:
    def __init__(self, work, port):
        self.dir = os.path.join(work, "registry")
        os.makedirs(os.path.join(self.dir, "data"))
        if not port:
            s = socket.socket()
            s.bind(("127.0.0.1", 0))
            port = s.getsockname()[1]
            s.close()
        self.addr = "127.0.0.1:%d" % port
        cfg = os.path.join(self.dir, "config.yml")
        with open(cfg, "w") as f:
            f.write("version: 0.1\nlog: {level: warn}\nstorage:\n  filesystem:\n"
                    "    rootdirectory: %s/data\nhttp:\n  addr: %s\n" % (self.dir, self.addr))
        self.log = open(os.path.join(self.dir, "log"), "w")
        self.proc = subprocess.Popen(["registry", "serve", cfg], stdout=self.log,
                                     stderr=subprocess.STDOUT)

    def wait_ready(self):
        """Poll the port until the registry accepts connections."""
        host, port = self.addr.rsplit(":", 1)
        for _ in range(100):
            if self.proc.poll() is not None:
                break
            try:
                socket.create_connection((host, int(port)), 0.2).close()
                return
            except OSError:
                time.sleep(0.1)
        raise SystemExit("the private registry did not start, see %s/log" % self.dir)

    def stop(self):
        self.proc.terminate()
        try:
            self.proc.wait(10)
        except subprocess.TimeoutExpired:
            self.proc.kill()
        self.log.close()


def local_name(ref):
    return ref.rsplit("/", 1)[-1]


def environment_text(a, engines, registry, loads):
    def version(name):
        e = engines.get(name)
        return out_of(e.argv + ["--version"], e.env) if e else "not measured"
    lines = ["date: " + time.strftime("%Y-%m-%d %H:%M:%S %z"),
             "kernel: " + out_of(["uname", "-r"]),
             "cpu: %s, %d CPUs" % (next((l.split(":", 1)[1].strip() for l in open("/proc/cpuinfo")
                                         if l.startswith("model name")), "?"), os.cpu_count()),
             "memory: " + next((l.split(":", 1)[1].strip() for l in open("/proc/meminfo")
                                if l.startswith("MemTotal")), "?"),
             "scratch fs: " + out_of(["stat", "-f", "-c", "%T", a.work]),
             "run root fs: " + out_of(["stat", "-f", "-c", "%T", a.runwork]),
             "velarx: " + version("velarx"),
             "podman: " + version("podman"),
             "crun: " + out_of([a.runtime, "--version"]).splitlines()[0],
             "hyperfine: " + out_of(["hyperfine", "--version"]),
             "registry: " + registry,
             "small image: %s, big image: %s" % (a.small_image, a.big_image),
             "runs: %d (warmup %d), slow benchmarks: %d runs" % (a.runs, a.warmup, a.slow_runs),
             "load average at start/end: %.2f / %.2f (max seen %.2f)" % (
                 loads[0], loads[-1], max(loads))]
    return "\n".join(lines) + "\n"


def run_benchmarks(a, engines, subst, outdir, loads):
    jdir = os.path.join(outdir, "json")
    os.makedirs(jdir, exist_ok=True)
    selected = [b for b in BENCHMARKS if not a.only or re.search(a.only, b["name"])]
    for b in selected:
        for e in a.tools:
            eng = engines[e]
            s = dict(subst, e=eng.prefix)
            fmt = lambda c: c.format(**s)
            path = os.path.join(jdir, "%s.%s.json" % (b["name"], e))
            if os.path.exists(path):
                os.unlink(path)
            say("== %s / %s" % (b["name"], e))
            try:
                for c in b["setup"]:
                    sh(fmt(c), eng.env)
                cmd = fmt(b["command"])
                hf = ["hyperfine", "--style", "basic", "--export-json", path]
                if b["kind"] == "slow":
                    hf += ["--warmup", "0", "--runs", str(a.slow_runs)]
                else:
                    hf += ["--warmup", str(a.warmup), "--runs", str(a.runs)]
                if b.get("prepare"):
                    hf += ["--prepare", "{ %s; } 2>>%s" % (
                        fmt(b["prepare"]), shlex.quote(os.path.join(outdir, "prepare.log")))]
                hf.append(cmd)
                p = subprocess.run(hf, env=eng.env, stdin=subprocess.DEVNULL,
                                   stdout=open(os.path.join(outdir, "hyperfine.log"), "a"),
                                   stderr=subprocess.STDOUT)
                if p.returncode != 0:
                    say("   hyperfine failed (exit %d), see hyperfine.log" % p.returncode)
                    if os.path.exists(path):
                        os.unlink(path)
            except RuntimeError as ex:
                say("   failed: %s" % ex)
            finally:
                for c in b.get("cleanup", []):
                    sh(fmt(c), eng.env, check=False)
        loads.append(loadavg())
        if loads[-1] > a.load_warn:
            say("WARNING: load average %.2f above %.1f: timings are noisy" % (loads[-1], a.load_warn))


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    here = os.path.dirname(os.path.abspath(__file__))
    ap.add_argument("--velarx", default=os.path.join(
        os.environ.get("CARGO_TARGET_DIR", os.path.join(here, "..", "target")), "release", "velarx"),
        help="the velarx binary (default: the release build)")
    ap.add_argument("--podman", default="podman")
    ap.add_argument("--runtime", default="crun", help="the OCI runtime of both (default crun)")
    ap.add_argument("--small-image", default="docker.io/library/alpine:latest")
    ap.add_argument("--big-image", default="docker.io/library/python:3.12")
    ap.add_argument("--registry", help="HOST:PORT of a plain HTTP registry holding the images as "
                    "NAME:TAG; without it a private one is started and seeded")
    ap.add_argument("--port", type=int, default=0, help="port of the private registry (default: free)")
    ap.add_argument("--runs", type=int, default=20)
    ap.add_argument("--warmup", type=int, default=3)
    ap.add_argument("--slow-runs", type=int, default=5, help="runs of the cold pulls and builds")
    ap.add_argument("--only", help="regexp: run the benchmarks whose name matches")
    ap.add_argument("--tools", default=",".join(ENGINES), help="comma list (default both)")
    ap.add_argument("--out", default="perf-compare-out")
    ap.add_argument("--tmp", default="/var/tmp", help="where the scratch directory is made")
    ap.add_argument("--runroot-base", default=os.environ.get("XDG_RUNTIME_DIR", "/dev/shm"),
                    help="a tmpfs directory for the run roots of both engines (default "
                    "$XDG_RUNTIME_DIR, which is where both keep them: a run root on a disk "
                    "makes every velarx command pay the syncs of its namespaces' file)")
    ap.add_argument("--load-warn", type=float, default=8.0)
    ap.add_argument("--list", action="store_true", help="list the benchmarks")
    ap.add_argument("--summarize", metavar="DIR", help="print the table of DIR/json and redo the graphs")
    a = ap.parse_args()

    if a.list:
        for b in BENCHMARKS:
            print("%-20s %s" % (b["name"], b["desc"]))
        return 0
    if a.summarize:
        res = load_results(a.summarize)
        text = table(res)
        with open(os.path.join(a.summarize, "summary.md"), "w") as f:
            f.write(text)
        write_graphs(res, a.summarize)
        print(text, end="")
        return 0

    a.tools = a.tools.split(",")
    for t in a.tools:
        if t not in ENGINES:
            sys.exit("unknown tool " + t)
    need = ["hyperfine", a.runtime, a.podman] + ([] if a.registry else ["skopeo", "registry"])
    for n in need:
        if not shutil.which(n):
            sys.exit("%s not found in PATH" % n)
    if not os.access(a.velarx, os.X_OK):
        sys.exit("%s is not executable: build it (make build PROFILE=release) or pass --velarx" % a.velarx)
    a.velarx = os.path.abspath(a.velarx)
    fstype = out_of(["stat", "-f", "-c", "%T", a.runroot_base])
    if fstype != "tmpfs":
        sys.exit("%s is on %s, not a tmpfs: the run roots would be on a disk (--runroot-base)"
                 % (a.runroot_base, fstype))
    if os.geteuid() == 0:
        say("note: running as root, the rootful engines are measured")
    outdir = os.path.abspath(a.out)
    os.makedirs(outdir, exist_ok=True)
    a.work = tempfile.mkdtemp(prefix="vxperf-", dir=a.tmp)
    os.chmod(a.work, 0o755)
    a.runwork = tempfile.mkdtemp(prefix="vxperf-", dir=a.runroot_base)
    free = shutil.disk_usage(a.work).free
    if free < 10 << 30:
        shutil.rmtree(a.runwork, ignore_errors=True)
        shutil.rmtree(a.work, ignore_errors=True)
        sys.exit("less than 10 GB free in %s: stop" % a.tmp)

    state = dict(engines={}, registry=None)

    def cleanup():
        for e in state["engines"].values():
            e.stop()
        if state["registry"]:
            state["registry"].stop()
        shutil.rmtree(a.runwork, ignore_errors=True)
        shutil.rmtree(a.work, ignore_errors=True)
        if os.path.exists(a.work):
            say("warning: %s was not removed completely" % a.work)

    atexit.register(cleanup)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    loads = [loadavg()]
    if loads[0] > a.load_warn:
        say("WARNING: load average %.2f above %.1f: timings are noisy" % (loads[0], a.load_warn))

    registry = a.registry
    if not registry:
        state["registry"] = Registry(a.work, a.port)
        state["registry"].wait_ready()
        registry = state["registry"].addr
        # (skopeo writes a blob info cache under XDG_DATA_HOME: a home of its own)
        s = os.path.join(a.work, "skopeo")
        senv = private_env(s + "/home", s + "/run", s + "/tmp")
        for src in (a.small_image, a.big_image):
            say("seeding %s" % src)
            subprocess.run(["skopeo", "copy", "--dest-tls-verify=false", "docker://" + src,
                            "docker://%s/%s" % (registry, local_name(src))], check=True,
                           env=senv, stdout=subprocess.DEVNULL)
    engines = {}
    for n, b in (("velarx", a.velarx), ("podman", a.podman)):
        if n in a.tools:
            engines[n] = Engine(n, b, a.work, a.runtime, a.runwork)
            engines[n].registries(registry)
            state["engines"][n] = engines[n]
            engines[n].verify_private()
    ctx = os.path.join(a.work, "ctx")
    os.makedirs(ctx)
    small = "%s/%s" % (registry, local_name(a.small_image))
    big = "%s/%s" % (registry, local_name(a.big_image))
    with open(os.path.join(ctx, "Containerfile"), "w") as f:
        f.write(CONTAINERFILE.format(small=small))
    subst = dict(small=shlex.quote(small), big=shlex.quote(big), ctx=shlex.quote(ctx))

    open(os.path.join(outdir, "hyperfine.log"), "w").close()
    run_benchmarks(a, engines, subst, outdir, loads)
    loads.append(loadavg())
    if loads[-1] > a.load_warn:
        say("WARNING: load average %.2f at the end" % loads[-1])
    with open(os.path.join(outdir, "environment.txt"), "w") as f:
        f.write(environment_text(a, engines, registry, loads))
    res = load_results(outdir)
    text = table(res)
    with open(os.path.join(outdir, "summary.md"), "w") as f:
        f.write(text)
    write_graphs(res, outdir)
    print(text, end="")
    return 0


if __name__ == "__main__":
    sys.exit(main())
