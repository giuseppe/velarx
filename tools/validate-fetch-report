# The measuring half of tools/validate-fetch (read its header first); each
# subcommand prints one JSON object on stdout and nothing else:
#
#   validate-fetch-report proxy UPSTREAM LOG   a logging proxy in front of a registry
#   validate-fetch-report sync STRACE LOG      the sync calls of a pull, per commit
#   validate-fetch-report requests LOG [A B]   the registry requests of lines A..B
#   validate-fetch-report store STORE          the objects of a store, duplicates
#   validate-fetch-report image HOST:PORT REPO TAG   the layers of an image, file bytes
#   validate-fetch-report table RESULT.json    the short table of a result file
#
# proxy listens on 0.0.0.0 on a free port (the nodes of other hosts reach it),
# prints the port on a line of its own, and serves until it is killed.  Every
# request is a line of LOG once it is answered, as tests/e2e/registry_log.py
# writes it: `METHOD PATH STATUS BYTES` (BYTES: the body sent).
import collections
import hashlib
import http.server
import io
import json
import os
import re
import sys
import tarfile
import threading
import urllib.error
import urllib.request
from datetime import datetime, timezone

SYNC_CALLS = ("syncfs", "fsync", "fdatasync", "sync_file_range", "sync")


def proxy(upstream, log):
    lock = threading.Lock()

    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *args):
            return None

    opener = urllib.request.build_opener(NoRedirect)

    class Proxy(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def forward(self):
            headers = {
                k: v
                for k, v in self.headers.items()
                if k.lower() not in ("host", "connection")
            }
            req = urllib.request.Request(
                f"http://{upstream}{self.path}", method=self.command, headers=headers
            )
            try:
                reply = opener.open(req)
            except urllib.error.HTTPError as e:
                reply = e
            body = b"" if self.command == "HEAD" else reply.read()
            self.send_response(reply.status)
            for k, v in reply.headers.items():
                if k.lower() not in ("connection", "transfer-encoding", "content-length"):
                    self.send_header(k, v)
            self.send_header(
                "Content-Length",
                reply.headers.get("Content-Length", str(len(body)))
                if self.command == "HEAD"
                else str(len(body)),
            )
            self.end_headers()
            self.wfile.write(body)
            with lock, open(log, "a") as f:
                f.write(f"{self.command} {self.path} {reply.status} {len(body)}\n")

        do_GET = forward
        do_HEAD = forward

        def log_message(self, *args):
            pass

    server = http.server.ThreadingHTTPServer(("0.0.0.0", 0), Proxy)
    print(server.server_address[1], flush=True)
    server.serve_forever()


def requests(log, first=1, last=None):
    """The requests of lines first..last (1-based, inclusive) of LOG."""
    blobs = collections.OrderedDict()
    manifests = 0
    total = 0
    n = 0
    with open(log) as f:
        for i, line in enumerate(f, 1):
            if i < first or (last is not None and i > last):
                continue
            parts = line.split()
            if len(parts) != 4:
                continue
            method, path, status, size = parts[0], parts[1], int(parts[2]), int(parts[3])
            n += 1
            m = re.search(r"/blobs/(sha\d+:[0-9a-f]+)", path)
            if m and method == "GET" and status < 300:
                blobs[m.group(1)] = blobs.get(m.group(1), 0) + size
                total += size
            elif "/manifests/" in path and method == "GET":
                manifests += 1
    return {
        "requests": n,
        "blob_gets": len(blobs),
        "blob_bytes": total,
        "manifest_gets": manifests,
        "blobs": dict(blobs),
    }


def ts_of_log(line):
    """The epoch time of the leading ISO timestamp of a tracing line, or None."""
    m = re.match(r"\s*(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d+)?)Z", line)
    if not m:
        return None
    t = datetime.fromisoformat(m.group(1)).replace(tzinfo=timezone.utc)
    return t.timestamp()


def sync_calls(strace, log):
    """Every sync call of the trace (`strace -f -ttt -y`), with the path of
    its file descriptor, then grouped by the commits of the pull: a commit
    ends at the debug line `commit of N files took`, and what happened since the
    end of the previous one (or the start) belongs to it."""
    calls = []
    rx = re.compile(
        r"^(?:\[pid\s+)?(\d+)\]?\s+(\d+\.\d+)\s+(" + "|".join(SYNC_CALLS) + r")\(([^)]*)\)\s*=\s*(-?\d+)"
    )
    with open(strace, errors="replace") as f:
        for line in f:
            m = rx.match(line)
            if not m:
                continue
            fdpath = re.search(r"<([^>]*)>", m.group(4))
            calls.append(
                {
                    "pid": int(m.group(1)),
                    "t": float(m.group(2)),
                    "call": m.group(3),
                    "path": fdpath.group(1) if fdpath else "",
                    "ret": int(m.group(5)),
                }
            )
    calls.sort(key=lambda c: c["t"])
    ends = []
    starts = []
    if log and os.path.exists(log):
        with open(log, errors="replace") as f:
            for line in f:
                t = ts_of_log(line)
                if t is None:
                    continue
                m = re.search(r"commit of (\d+) files took", line)
                if m:
                    ends.append(t)
                    starts.append((t, int(m.group(1))))
    # a syncfs of the staging directory is the one before the link step, of
    # the objects directory the one after it, of composefs the one after the
    # EROFS images of the layers are written; an fsync of a SQLite file is a
    # database commit; any other fsync is a record of a layer or an image
    def kind(c):
        p = c["path"]
        if c["call"] == "syncfs":
            if "/staging/" in p:
                return "syncfs_staging"
            if p.rstrip("/").endswith("/objects"):
                return "syncfs_objects"
            if p.rstrip("/").endswith("/composefs"):
                return "syncfs_composefs"
            return "syncfs_other"
        # the commits of the SQLite database are not a layer's
        if ".sqlite" in p:
            return "db_" + c["call"]
        return c["call"]

    for c in calls:
        c["kind"] = kind(c)
    commits = []
    lo = 0.0
    for e in ends:
        group = [c for c in calls if lo < c["t"] <= e + 0.01]
        commits.append(group)
        lo = e + 0.01
    rest = [c for c in calls if c["t"] > lo]
    if rest:
        commits.append(rest)
    if not ends:
        commits = [calls] if calls else []
    out = []
    for g in commits:
        cnt = collections.Counter(c["kind"] for c in g)
        out.append(dict(cnt))
    total = collections.Counter(c["kind"] for c in calls)
    return {
        "calls_total": len(calls),
        "by_kind": dict(total),
        "commits_logged": len(ends),
        "staged_files_per_commit": [n for _, n in starts],
        "per_commit": out,
        "paths": sorted({(c["kind"], re.sub(r"/[0-9a-f]{16,}", "/<digest>", c["path"])) for c in calls}),
    }


def store(root):
    """The objects of a store: the files, the bytes, the content that is stored
    more than once (it must be nothing), the files with more than one name."""
    objdir = os.path.join(root, "objects")
    by_inode = {}
    by_hash = collections.defaultdict(list)
    n = 0
    for d, _, files in os.walk(objdir):
        for name in files:
            p = os.path.join(d, name)
            st = os.lstat(p)
            if not os.path.isfile(p) or os.path.islink(p):
                continue
            n += 1
            by_inode[st.st_ino] = (st.st_size, st.st_nlink)
            h = hashlib.sha256()
            with open(p, "rb") as f:
                for chunk in iter(lambda: f.read(1 << 20), b""):
                    h.update(chunk)
            by_hash[(st.st_size, h.hexdigest())].append(p)
    dups = {f"{s}:{h[:12]}": len(v) for (s, h), v in by_hash.items() if len(v) > 1 and s > 0}
    # a file counted once per inode (hard links are one file)
    seen = set()
    du_unique = 0
    for d, _, files in os.walk(root):
        for name in files:
            try:
                st = os.lstat(os.path.join(d, name))
            except OSError:
                continue
            if (st.st_dev, st.st_ino) in seen:
                continue
            seen.add((st.st_dev, st.st_ino))
            du_unique += st.st_blocks * 512
    return {
        "objects": n,
        "object_bytes": sum(s for s, _ in by_inode.values()),
        "objects_with_links": sum(1 for _, l in by_inode.values() if l > 1),
        "duplicate_contents": dups,
        "store_disk_bytes": du_unique,
    }


def image(hostport, repo, tag):
    """The layers of an image of a plain HTTP registry and the bytes of the
    regular files of each (hard links count once, per layer)."""

    def get(path, accept=None):
        req = urllib.request.Request(f"http://{hostport}{path}")
        if accept:
            req.add_header("Accept", accept)
        with urllib.request.urlopen(req) as r:
            return r.read()

    accept = ",".join(
        [
            "application/vnd.oci.image.manifest.v1+json",
            "application/vnd.docker.distribution.manifest.v2+json",
            "application/vnd.oci.image.index.v1+json",
            "application/vnd.docker.distribution.manifest.list.v2+json",
        ]
    )
    m = json.loads(get(f"/v2/{repo}/manifests/{tag}", accept))
    if "manifests" in m:
        d = m["manifests"][0]["digest"]
        m = json.loads(get(f"/v2/{repo}/manifests/{d}", accept))
    layers = []
    for l in m["layers"]:
        blob = get(f"/v2/{repo}/blobs/{l['digest']}")
        files = 0
        with tarfile.open(fileobj=io.BytesIO(blob), mode="r:*") as t:
            for ti in t:
                if ti.isreg():
                    files += ti.size
        layers.append({"digest": l["digest"], "compressed": l["size"], "file_bytes": files})
    return {
        "config": m["config"]["digest"],
        "layers": layers,
        "file_bytes": sum(l["file_bytes"] for l in layers),
        "compressed": sum(l["compressed"] for l in layers),
    }


def mib(n):
    return f"{n / 1048576:.1f} MiB"


def table(path):
    r = json.load(open(path))
    rows = []
    for k, v in r.get("table", {}).items():
        rows.append((k, v))
    w = max([len(k) for k, _ in rows] + [4])
    print(f"{'check':<{w}}  result")
    for k, v in rows:
        print(f"{k:<{w}}  {v}")


def main():
    a = sys.argv[1:]
    if not a:
        sys.exit(__doc__)
    cmd = a[0]
    if cmd == "proxy":
        proxy(a[1], a[2])
        return
    if cmd == "table":
        table(a[1])
        return
    if cmd == "requests":
        out = requests(a[1], int(a[2]) if len(a) > 2 else 1, int(a[3]) if len(a) > 3 else None)
    elif cmd == "sync":
        out = sync_calls(a[1], a[2] if len(a) > 2 else None)
    elif cmd == "store":
        out = store(a[1])
    elif cmd == "image":
        out = image(a[1], a[2], a[3])
    else:
        sys.exit(f"unknown subcommand {cmd}")
    json.dump(out, sys.stdout)
    print()


main()
