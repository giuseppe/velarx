# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Velarx CRI (Kubernetes container runtime interface)
Documentation=man:velarx(1) man:velarx.conf(5)
Requires=velarx-cri.socket velarx-engine.socket
After=velarx-cri.socket velarx-engine.socket
# The engine is started by its socket (velarx-engine.socket) when the first
# call connects to it; this unit starts nothing.

# started by a connection after each end: no start limit
StartLimitIntervalSec=0
[Service]
# A frontend of the engine: it decodes gRPC and calls the engine over
# varlink (org.velarx.Engine).  It confines itself further (Landlock,
# seccomp: it reaches the engine's socket and the checkpoint directory of
# the kubelet, and executes nothing).  It ends when the engine can no longer
# be reached, and the next connection of the kubelet starts it again.
ExecStart=/usr/bin/velarx-cri
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# the directory of the checkpoints of the kubelet (made by the frontend)
ReadWritePaths=-/var/lib/kubelet
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
# (the streaming server of exec, attach and port-forward listens on the
# loopback)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
