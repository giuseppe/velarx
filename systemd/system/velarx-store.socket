# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Velarx store service socket
Documentation=man:velarx(1) man:velarx.conf(5)

[Socket]
# org.velarx.Store: the content of the store for the P2P service (and
# whatever else serves it to others), started by the first connection
ListenStream=/run/velarx/services/store.sock
SocketMode=0600
DirectoryMode=0700

[Install]
WantedBy=sockets.target
