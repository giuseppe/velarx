# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Velarx REST API
Documentation=man:velarx-api(8) man:velarx.conf(5)
Requires=velarx-api.socket
After=velarx-api.socket
# No dependency on the engine: the first request connects to its socket,
# which starts it.

# started by a connection after each idle exit: no start limit
StartLimitIntervalSec=0
[Service]
# A frontend of the engine: it decodes HTTP and calls the engine over
# varlink.  It leaves after [api] idle_exit seconds with no connection.
# It confines itself further (Landlock, seccomp: it reaches the engine's
# socket and nothing else), and has no access to the storage, the database
# or the credentials.
ExecStart=/usr/bin/velarx-api
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
