# The P2P service of a user (rootless): `systemctl --user enable --now
# velarx-p2p`, with its p2p.toml next to the configuration (the swarm key).  It needs no
# daemon: the content it serves comes from the store service.  `velarx p2p
# status` asks it on its own socket (org.velarx.P2p).
[Unit]
Description=Velarx P2P service
Documentation=man:velarx-p2p(8) man:velarx.conf(5)
Wants=velarx-store.socket
After=network.target velarx-store.socket

[Service]
ExecStart=/usr/bin/velarx-p2p
Restart=on-failure
RestartSec=5
RuntimeDirectory=velarx
RuntimeDirectoryPreserve=yes
# It talks to the network: it needs its sockets in $XDG_RUNTIME_DIR, its
# configuration and swarm key (read), the network, and nothing else.  The
# process confines itself further (Landlock, seccomp:
# crates/p2p/src/sandbox.rs).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# (and the root directory of the engine, where the identity of the node is made
# before the process confines itself: identity_path of p2p.toml)
ReadWritePaths=%t/velarx -%h/.local/share/velarx
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
# netlink: the interfaces mDNS watches
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @module @reboot @swap @clock @debug @obsolete @cpu-emulation
# what the process needs to confine itself (limits, Landlock, seccomp); a
# call the filter refuses fails, it does not kill
SystemCallFilter=capset prlimit64 setrlimit landlock_create_ruleset landlock_add_rule landlock_restrict_self seccomp
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
